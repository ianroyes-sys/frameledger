# --- Staging helper scripts only (scripts/configure-staging-deployment.mjs, scripts/verify-hosted-workspace.mjs) ---
# Supabase URL of the staging project the hosted acceptance test is allowed to write to
STAGING_SUPABASE_URL=
# Vercel project/org IDs that .vercel/project.json must match before env upload
STAGING_VERCEL_PROJECT_ID=
STAGING_VERCEL_ORG_ID=
# Vercel team slug passed as --scope
STAGING_VERCEL_SCOPE=
# Public HTTPS origin of the staging deployment
STAGING_APP_ORIGIN=
